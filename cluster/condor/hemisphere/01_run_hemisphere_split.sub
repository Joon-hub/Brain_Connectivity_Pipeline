# HTCondor Submit File for Hemisphere Data Splitting
universe = vanilla
executable = cluster/condor/hemisphere/01_run_hemisphere_split.sh

getenv = True
initialdir = /home/sjoon/projects/brain_connectivity_classifier/

should_transfer_files = IF_NEEDED
